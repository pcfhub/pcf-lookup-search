<?xml version="1.0" encoding="utf-8"?>
<root>
  <!--
    Spanish (3082) strings for everything declared in
    ControlManifest.Input.xml, plus the strings index.ts renders at runtime.
    PCFHub reads the manifest, so the property names and descriptions here are
    what appear in the component's API reference as well as in the maker's
    properties pane.

    All five files carry the SAME key set. A key missing from one language falls
    back to the key name in that language only, which nobody notices until a
    customer does — so change them together, or not at all.
  -->
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="metadata">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" />
              </xsd:sequence>
              <xsd:attribute name="name" use="required" type="xsd:string" />
              <xsd:attribute name="type" type="xsd:string" />
              <xsd:attribute name="mimetype" type="xsd:string" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="assembly">
            <xsd:complexType>
              <xsd:attribute name="alias" type="xsd:string" />
              <xsd:attribute name="name" type="xsd:string" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" msdata:Ordinal="2" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" msdata:Ordinal="1" />
              <xsd:attribute name="type" type="xsd:string" msdata:Ordinal="3" />
              <xsd:attribute name="mimetype" type="xsd:string" msdata:Ordinal="4" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <data name="LookupSearch_Name" xml:space="preserve">
    <value>Búsqueda de registros</value>
  </data>
  <data name="LookupSearch_Desc" xml:space="preserve">
    <value>Una columna de búsqueda como un campo de escritura anticipada sobre la tabla de destino.</value>
  </data>
  <data name="value_Name" xml:space="preserve">
    <value>Valor</value>
  </data>
  <data name="value_Desc" xml:space="preserve">
    <value>La columna de búsqueda que este control lee y escribe.</value>
  </data>
  <data name="placeholder_Name" xml:space="preserve">
    <value>Marcador de posición</value>
  </data>
  <data name="placeholder_Desc" xml:space="preserve">
    <value>Texto de ayuda que se muestra mientras no hay ningún registro seleccionado.</value>
  </data>
  <data name="matchMode_Name" xml:space="preserve">
    <value>Modo de coincidencia</value>
  </data>
  <data name="matchMode_Desc" xml:space="preserve">
    <value>Cómo se compara el texto escrito: desde el inicio del valor o en cualquier parte de él. «Empieza por» es la opción más rápida.</value>
  </data>
  <data name="matchMode_StartsWith_Name" xml:space="preserve">
    <value>Empieza por</value>
  </data>
  <data name="matchMode_Contains_Name" xml:space="preserve">
    <value>Contiene</value>
  </data>
  <data name="minimumCharacters_Name" xml:space="preserve">
    <value>Caracteres mínimos</value>
  </data>
  <data name="minimumCharacters_Desc" xml:space="preserve">
    <value>Cuántos caracteres deben escribirse antes de ejecutar una búsqueda. Valor predeterminado: 2.</value>
  </data>
  <data name="maxResults_Name" xml:space="preserve">
    <value>Resultados máximos</value>
  </data>
  <data name="maxResults_Desc" xml:space="preserve">
    <value>Cuántas coincidencias se muestran. Valor predeterminado: 8.</value>
  </data>
  <data name="secondaryColumn_Name" xml:space="preserve">
    <value>Columna secundaria</value>
  </data>
  <data name="secondaryColumn_Desc" xml:space="preserve">
    <value>Nombre lógico de una columna que se muestra bajo cada resultado, por ejemplo emailaddress1. Déjelo vacío para no mostrar ninguna.</value>
  </data>
  <data name="searchColumns_Name" xml:space="preserve">
    <value>Columnas de búsqueda</value>
  </data>
  <data name="searchColumns_Desc" xml:space="preserve">
    <value>Columnas adicionales en las que buscar, separadas por comas. La columna de nombre principal de la tabla siempre se busca.</value>
  </data>
  <data name="allowBrowse_Name" xml:space="preserve">
    <value>Permitir examinar</value>
  </data>
  <data name="allowBrowse_Desc" xml:space="preserve">
    <value>Muestra un botón que abre el panel de búsqueda propio de la plataforma, para cuando el cuadro de búsqueda no encuentra el registro.</value>
  </data>
  <data name="LookupSearch_NoAccess" xml:space="preserve">
    <value>No tiene acceso a este valor.</value>
  </data>
  <data name="LookupSearch_Browse" xml:space="preserve">
    <value>Examinar</value>
  </data>
  <data name="LookupSearch_Clear" xml:space="preserve">
    <value>Borrar</value>
  </data>
  <data name="LookupSearch_Searching" xml:space="preserve">
    <value>Buscando…</value>
  </data>
  <data name="LookupSearch_NoMatches" xml:space="preserve">
    <value>No hay registros coincidentes.</value>
  </data>
  <data name="LookupSearch_TypeMore" xml:space="preserve">
    <value>Escriba al menos {0} caracteres para buscar.</value>
  </data>
  <data name="LookupSearch_SearchUnavailable" xml:space="preserve">
