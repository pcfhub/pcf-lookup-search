  </data>
  <data name="minimumCharacters_Desc" xml:space="preserve">
    <value>Nombre de caractères à saisir avant qu'une recherche soit lancée. Par défaut 2.</value>
  </data>
  <data name="maxResults_Name" xml:space="preserve">
    <value>Nombre maximal de résultats</value>
  </data>
  <data name="maxResults_Desc" xml:space="preserve">
    <value>Nombre de correspondances affichées. Par défaut 8.</value>
  </data>
  <data name="secondaryColumn_Name" xml:space="preserve">
    <value>Colonne secondaire</value>
  </data>
  <data name="secondaryColumn_Desc" xml:space="preserve">
    <value>Nom logique d'une colonne affichée sous chaque résultat, par exemple emailaddress1. Laissez vide pour n'en afficher aucune.</value>
  </data>
  <data name="searchColumns_Name" xml:space="preserve">
    <value>Colonnes de recherche</value>
  </data>
  <data name="searchColumns_Desc" xml:space="preserve">
    <value>Colonnes supplémentaires à interroger, séparées par des virgules. La colonne de nom principal de la table est toujours interrogée.</value>
  </data>
  <data name="allowBrowse_Name" xml:space="preserve">
    <value>Autoriser la recherche avancée</value>
  </data>
  <data name="allowBrowse_Desc" xml:space="preserve">
    <value>Affiche un bouton qui ouvre le volet de recherche natif de la plateforme, lorsque la zone de recherche ne suffit pas.</value>
  </data>
  <data name="LookupSearch_NoAccess" xml:space="preserve">
    <value>Vous n'avez pas accès à cette valeur.</value>
  </data>
  <data name="LookupSearch_Browse" xml:space="preserve">
    <value>Parcourir</value>
  </data>
  <data name="LookupSearch_Clear" xml:space="preserve">
    <value>Effacer</value>
  </data>
  <data name="LookupSearch_Searching" xml:space="preserve">
    <value>Recherche en cours…</value>
  </data>
  <data name="LookupSearch_NoMatches" xml:space="preserve">
    <value>Aucun enregistrement correspondant.</value>
  </data>
  <data name="LookupSearch_TypeMore" xml:space="preserve">
    <value>Saisissez au moins {0} caractères pour lancer la recherche.</value>
  </data>
  <data name="LookupSearch_SearchUnavailable" xml:space="preserve">
